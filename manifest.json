{
  "manifest_version": 3,
  "name": "Research Buddy - Web Highlighter & Note Exporter",
  "version": "1.0",
  "description": "Highlight web text, save snippets with source URLs, and export notes into readable TXT/Markdown format.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
